{
  "manifest_version": 3,
  "name": "TrustLens",
  "version": "0.1.0",
  "description": "Warns you before you open scam, phishing or malware links, and explains why.",
  "action": { "default_popup": "popup.html", "default_title": "TrustLens", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost:3000/*"]
}
