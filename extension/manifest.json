{
  "manifest_version": 3,
  "name": "TrustLens",
  "version": "0.3.0",
  "description": "Stops you before you open scam, phishing or malware links, and explains why.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustLens is protecting you",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}